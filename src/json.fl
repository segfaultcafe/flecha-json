module json;

@imports
    :: lib::std::containers::collections as coll
    :: lib::std::text::strings;

/*
    Typed JSON metadata. Serialization is implemented by the library behavior
    in json_behavior.fl and uses the streaming Writer protocol.
*/
export decoration json {
    application(structure) target structure;
    application(stringv name) target structure::field;
};

export interface JsonWritable {
    error writeJson(&const self, &Writer writer) virtual;
    (own []u8, error) json(&const self) default;
};

export interface JsonReadable {
    error readJson(&self, &Reader reader) virtual;
};

export error JsonError {
    InvalidState,
    IncompleteDocument,
    NonFiniteNumber,
    InvalidSyntax,
    UnexpectedEnd,
    TypeMismatch,
    NumberOutOfRange,
    TrailingData,
}

enum ContainerKind {
    default Object,
    Array,
}

structure Frame {
    ContainerKind kind;
    usize count;
    bool waitingForValue;
};

export structure Writer {
    private {
        strings::StringBuilder output;
        coll::Array<Frame> frames;
        error failure;
        bool rootWritten;
    }
};

export structure Reader {
    private {
        []const u8 source;
        usize position;
        error failure;

        usize keyStart;
        usize keyEnd;
        bool keyEscaped;

        coll::Array<Frame> frames;
        bool rootRead;
    }
};
